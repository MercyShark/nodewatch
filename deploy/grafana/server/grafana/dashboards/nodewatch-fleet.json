{
 "uid": "nodewatch-fleet",
 "title": "Nodewatch \u00b7 Fleet",
 "tags": [
  "nodewatch"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "node",
    "label": "Node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(nodewatch_healthy, node)",
     "refId": "v"
    },
    "definition": "label_values(nodewatch_healthy, node)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": [
      "$__all"
     ]
    },
    "refresh": 2,
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "id": 10,
   "title": "Nodes",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(nodewatch_healthy{node=~\"$node\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "title": "Healthy",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(nodewatch_healthy{node=~\"$node\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "title": "Needing attention",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(nodewatch_healthy{node=~\"$node\"} == 0) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 13,
   "title": "Fleet req/s",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(nodewatch_rpc_requests_total{node=~\"$node\"}[5m]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 14,
   "title": "Fleet p95",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(nodewatch_rpc_duration_seconds_bucket{node=~\"$node\"}[5m]))) * 1000",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 15,
   "title": "Slow last hour",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(nodewatch_rpc_slow_requests_total{node=~\"$node\",level=\"slow\"}[1h])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 1,
   "title": "Fleet",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "nodewatch_healthy{node=~\"$node\"}",
     "legendFormat": "",
     "refId": "A",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "nodewatch_head_lag_blocks{node=~\"$node\"}",
     "legendFormat": "",
     "refId": "B",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "nodewatch_el_peers{node=~\"$node\"}",
     "legendFormat": "",
     "refId": "C",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "nodewatch_disk_days_left{node=~\"$node\"}",
     "legendFormat": "",
     "refId": "D",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "nodewatch_inline_mode{node=~\"$node\"}",
     "legendFormat": "",
     "refId": "E",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (node) (rate(nodewatch_rpc_requests_total{node=~\"$node\"}[5m]))",
     "legendFormat": "",
     "refId": "F",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (node, le) (rate(nodewatch_rpc_duration_seconds_bucket{node=~\"$node\"}[5m]))) * 1000",
     "legendFormat": "",
     "refId": "G",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min by (node) (nodewatch_container_up{node=~\"$node\"})",
     "legendFormat": "",
     "refId": "H",
     "format": "table",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - max by (node) (nodewatch_process_process_start_time_seconds{node=~\"$node\"})",
     "legendFormat": "",
     "refId": "I",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "joinByField",
     "options": {
      "byField": "node",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true,
       "Time 7": true,
       "Time 8": true,
       "Time 9": true,
       "Time": true,
       "__name__ 1": true,
       "__name__ 2": true,
       "__name__ 3": true,
       "__name__ 4": true,
       "__name__ 5": true,
       "__name__": true,
       "instance": true,
       "instance 1": true,
       "instance 2": true,
       "instance 3": true,
       "instance 4": true,
       "instance 5": true,
       "instance 6": true,
       "instance 7": true,
       "instance 8": true,
       "instance 9": true,
       "job": true,
       "job 1": true,
       "job 2": true,
       "job 3": true,
       "job 4": true,
       "job 5": true,
       "job 6": true,
       "job 7": true,
       "job 8": true,
       "job 9": true
      },
      "renameByName": {
       "node": "Node",
       "Value #A": "Healthy",
       "Value #B": "Head lag",
       "Value #C": "EL peers",
       "Value #D": "Disk days left",
       "Value #E": "Inline",
       "Value #F": "Req/s",
       "Value #G": "p95 ms",
       "Value #H": "Containers up",
       "Value #I": "Nodewatch uptime"
      },
      "indexByName": {
       "node": 0,
       "Value #A": 1,
       "Value #H": 2,
       "Value #B": 3,
       "Value #C": 4,
       "Value #D": 5,
       "Value #E": 6,
       "Value #F": 7,
       "Value #G": 8,
       "Value #I": 9
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "decimals": 1
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Healthy"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "attention",
            "color": "red"
           },
           "1": {
            "text": "healthy",
            "color": "green"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Containers up"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "down",
            "color": "red"
           },
           "1": {
            "text": "up",
            "color": "green"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Inline"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "passive"
           },
           "1": {
            "text": "inline",
            "color": "blue"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Disk days left"
      },
      "properties": [
       {
        "id": "unit",
        "value": "d"
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 2
          },
          {
           "color": "green",
           "value": 7
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Head lag"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 5
          },
          {
           "color": "red",
           "value": 10
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Nodewatch uptime"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "p95 ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Node"
     }
    ]
   }
  },
