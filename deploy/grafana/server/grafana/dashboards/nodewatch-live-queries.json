{
 "uid": "nodewatch-live-queries",
 "title": "Nodewatch \u00b7 Live queries",
 "tags": [
  "nodewatch"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "node",
    "label": "Node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(nodewatch_healthy, node)",
     "refId": "v"
    },
    "definition": "label_values(nodewatch_healthy, node)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": [
      "$__all"
     ]
    },
    "refresh": 2,
    "sort": 1
   },
   {
    "name": "method",
    "label": "Method",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(nodewatch_rpc_requests_total{node=~\"$node\"}, method)",
     "refId": "v"
    },
    "definition": "label_values(nodewatch_rpc_requests_total{node=~\"$node\"}, method)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": [
      "$__all"
     ]
    },
    "refresh": 2,
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "id": 30,
   "title": "Req/s",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(nodewatch_rpc_requests_total{node=~\"$node\",method=~\"$method\"}[1m]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 31,
   "title": "p95",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(nodewatch_rpc_duration_seconds_bucket{node=~\"$node\",method=~\"$method\"}[5m]))) * 1000",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 32,
   "title": "Error rate",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(rate(nodewatch_rpc_requests_total{node=~\"$node\",method=~\"$method\",outcome=\"error\"}[5m])) / sum(rate(nodewatch_rpc_requests_total{node=~\"$node\",method=~\"$method\"}[5m]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 33,
   "title": "Slow (last 15 m)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(nodewatch_rpc_slow_requests_total{node=~\"$node\",method=~\"$method\",level=\"slow\"}[15m])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 34,
   "title": "Critical (last 15 m)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(nodewatch_rpc_slow_requests_total{node=~\"$node\",method=~\"$method\",level=\"critical\"}[15m])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 35,
   "title": "Nodes inline",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(nodewatch_inline_mode{node=~\"$node\"}) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 40,
   "title": "Requests per second by node",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (node) (rate(nodewatch_rpc_requests_total{node=~\"$node\",method=~\"$method\"}[1m]))",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 41,
   "title": "Requests per second by method",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (method) (rate(nodewatch_rpc_requests_total{node=~\"$node\",method=~\"$method\"}[1m]))",
     "legendFormat": "{{method}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 42,
   "title": "Latency p50 / p95 / p99",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.50, sum by (le) (rate(nodewatch_rpc_duration_seconds_bucket{node=~\"$node\",method=~\"$method\"}[5m]))) * 1000",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(nodewatch_rpc_duration_seconds_bucket{node=~\"$node\",method=~\"$method\"}[5m]))) * 1000",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(nodewatch_rpc_duration_seconds_bucket{node=~\"$node\",method=~\"$method\"}[5m]))) * 1000",
     "legendFormat": "p99",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "orange",
        "value": 750
       },
       {
        "color": "red",
        "value": 3000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 43,
   "title": "Error rate",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum by (node) (rate(nodewatch_rpc_requests_total{node=~\"$node\",method=~\"$method\",outcome=\"error\"}[5m])) / sum by (node) (rate(nodewatch_rpc_requests_total{node=~\"$node\",method=~\"$method\"}[5m]))",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 44,
   "title": "Slow and critical requests per minute",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (node, level) (increase(nodewatch_rpc_slow_requests_total{node=~\"$node\",method=~\"$method\"}[1m]))",
     "legendFormat": "{{node}} {{level}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 45,
   "title": "Errors by code (last 5 m)",
   "type": "barchart",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (method, code) (increase(nodewatch_rpc_errors_total{node=~\"$node\",method=~\"$method\"}[5m])) > 0",
     "legendFormat": "{{method}} {{code}}",
     "refId": "A",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "instance": true,
       "instance 1": true,
       "instance 2": true,
       "instance 3": true,
       "instance 4": true,
       "instance 5": true,
       "instance 6": true,
       "instance 7": true,
       "instance 8": true,
       "instance 9": true,
       "job": true,
       "job 1": true,
       "job 2": true,
       "job 3": true,
       "job 4": true,
       "job 5": true,
       "job 6": true,
       "job 7": true,
       "job 8": true,
       "job 9": true
      },
      "renameByName": {
       "Value": "errors"
      }
     }
    }
   ],
   "options": {
    "orientation": "horizontal",
    "xField": "method",
    "showValue": "auto",
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 50,
   "title": "Live requests (newest first)",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{node=~\"$node\", method=~\"$method\"} | json | line_format \"{{printf \\\"%6.0f\\\" .ms}} ms  {{.method}}  {{.query}}{{if .error}}  \u2192 {{.error}}{{end}}\"",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "showLabels": false,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  },
  {
   "id": 51,
   "title": "Slow requests (over 750 ms)",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 12,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{node=~\"$node\", method=~\"$method\"} | json | ms >= 750 | line_format \"{{printf \\\"%6.0f\\\" .ms}} ms  {{.method}}  {{.query}}{{if .error}}  \u2192 {{.error}}{{end}}\"",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "showLabels": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   }
  },
  {
   "id": 52,
   "title": "Failed requests with the node's answer",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 39,
    "w": 12,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{node=~\"$node\", method=~\"$method\", ok=\"false\"} | json | line_format \"{{.method}}  {{.query}}  \u2192 {{.error}}\"",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "showLabels": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   }
  },
  {
   "id": 53,
   "title": "Top arkiv_query shapes (last hour)",
   "type": "bargauge",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 51,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "topk(10, sum by (shape) (count_over_time({node=~\"$node\", method=\"arkiv_query\"} | json | shape != \"\" [1h])))",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showUnfilled": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "continuous-BlPu"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 54,
   "title": "Requests per node, last hour",
   "type": "bargauge",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 51,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (node) (count_over_time({node=~\"$node\"} [1h]))",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showUnfilled": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "continuous-GrYlRd"
     }
    },
    "overrides": []
   }
  }
 ],
 "links": [
  {
   "title": "Fleet",
   "type": "dashboards",
   "tags": [
    "nodewatch"
   ],
   "asDropdown": false,
