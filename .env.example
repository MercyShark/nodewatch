# Nodewatch configuration. Copy to .env (chmod 600). A missing optional value disables that feature.
# Defaults shown are the built-in ones; you only need to set the lines marked REQUIRED.

# ---- server ----
HOST=127.0.0.1                 # UI/API bind address. 0.0.0.0 = public (then limit the security group to trusted IPs)
PORT=8080
PROXY_HOST=127.0.0.1           # RPC proxy bind address: keep on loopback
PROXY_PORT=18545               # optional RPC proxy in front of the node's :8545
PROXY_MODE=passive
INSTANCE_NAME=my-arkiv-node    # REQUIRED: shown in the UI and in alerts
NODE_KIT_DIR=/opt/arkiv-community-node

# ---- node (host loopback) ----
NODE_COMPOSE_PROJECT=arkiv-community-node
EL_RPC_URL=http://127.0.0.1:8545
CL_API_URL=http://127.0.0.1:5052
TUNNEL_STATUS_URL=http://127.0.0.1:7400/api/status
PROVIDER_ADDRESS=              # REQUIRED for the pool view: the node kit's provider address (read only)

# ---- autopilot (keeps the node in the pool without an operator) ----
AUTOPILOT_INTERVAL_SEC=60
PROVIDER_KEYSTORE_PASSWORD=    # optional: unlocks the provider keystore at boot, in memory only, for zero-touch
                               # renewals across restarts. Without it, unlock once per restart in Pool -> Autopilot.

# ---- Arkiv ----
ARKIV_CHAIN_ID=7794095
ARKIV_REFERENCE_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
HEARTBEAT_ENABLED=false        # true once HEARTBEAT_PRIVATE_KEY is funded with tGLM
HEARTBEAT_PRIVATE_KEY=         # separate hot key. NEVER the provider key
HEARTBEAT_INTERVAL_SEC=30
HEARTBEAT_EXPIRY_BLOCKS=60
FLEET_TRUSTED_CREATORS=        # comma-separated heartbeat writer addresses to show in Fleet
LOW_GAS_THRESHOLD_GLM=0.5

# ---- Swarm vault ----
BEE_MODE=external
BEE_API_URL=                   # e.g. http://127.0.0.1:1633
BEE_POSTAGE_BATCH_ID=
BUNDLE_WRITER_PRIVATE_KEY=     # defaults to the heartbeat key when empty
ARKIV_RECIPIENT_ADDRESS=       # registered from a wallet signature in the UI
OPERATOR_RECIPIENT_ADDRESS=

# ---- auth ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=           # optional fallback; empty = wallet-only login. pnpm --filter @nodewatch/server hash-password
ADMIN_ADDRESSES=               # REQUIRED (or ADMIN_PASSWORD_HASH): SIWE admin wallets, comma-separated. Never the provider or heartbeat key
VIEWER_ADDRESSES=              # SIWE read-only viewers (e.g. judges)
VIEWER_ANY_WALLET=false        # true: any signed-in wallet gets read-only viewer access
SESSION_SECRET=                # random 32+ bytes; generated and stored in DATA_DIR when empty
PUBLIC_ORIGIN=http://localhost:8080

# ---- alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAGERDUTY_ROUTING_KEY=

# ---- fleet view (deploy/grafana) ----
METRICS_TOKEN=                  # bearer token for a remote Prometheus scraper; unset = /metrics answers loopback only
REQUEST_LOG=true                # one JSON line per request in DATA_DIR/requests.jsonl for the Grafana agent

# ---- backups ----
BACKUP_SWARM_ENABLED=false
BACKUP_INTERVAL_HOURS=24

# ---- slow-query finder (targets only our own node or the sandbox) ----
BENCH_PRIVATE_KEY=             # own-node runs only; must differ from the heartbeat key (sandbox runs need no key)
BENCH_RUNS_PER_SHAPE=30
BENCH_WARMUP_RUNS=5
BENCH_SEED_PARALLEL=8           # seeding batches in flight (own-node runs are capped at 4)
